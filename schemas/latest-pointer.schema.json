{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness-reserve.local/schemas/latest-pointer.schema.json",
  "title": "Harness Reserve latest receipt pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "receipt_path",
    "receipt_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "receipt_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "^[/\\\\]"
          },
          {
            "pattern": "(^|[/\\\\])\\.\\.([/\\\\]|$)"
          },
          {
            "pattern": ":"
          },
          {
            "pattern": "\\u0000"
          }
        ]
      }
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
