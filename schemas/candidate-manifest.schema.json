{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness-reserve.local/schemas/candidate-manifest.schema.json",
  "title": "Harness Reserve candidate-only reasoning output",
  "description": "Protocol artifact for project-owned candidate generation and validation. Schema validity does not grant promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "project_id",
    "candidate_id",
    "kind",
    "created_at",
    "provider",
    "input_bindings",
    "outputs",
    "validation",
    "promotion_state"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "project_id": {
      "$ref": "#/definitions/id"
    },
    "candidate_id": {
      "$ref": "#/definitions/id"
    },
    "kind": {
      "$ref": "#/definitions/id"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "provider": {
      "$ref": "#/definitions/provider"
    },
    "input_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/inputBinding"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/output"
      }
    },
    "validation": {
      "$ref": "#/definitions/validation"
    },
    "promotion_state": {
      "enum": [
        "CANDIDATE",
        "VALIDATED",
        "REJECTED",
        "PROMOTED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "promotion_state": {
            "enum": [
              "VALIDATED",
              "PROMOTED"
            ]
          }
        },
        "required": [
          "promotion_state"
        ]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "state": {
                "const": "PASS"
              }
            },
            "required": [
              "state"
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projectRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "^[/\\\\]"
          },
          {
            "pattern": "(^|[/\\\\])\\.\\.([/\\\\]|$)"
          },
          {
            "pattern": ":"
          },
          {
            "pattern": "\\u0000"
          }
        ]
      }
    },
    "candidateOutputPath": {
      "type": "string",
      "pattern": "^outputs[/\\\\][^\\u0000]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "(^|[/\\\\])\\.\\.([/\\\\]|$)"
          },
          {
            "pattern": ":"
          }
        ]
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "pattern": "\\S"
        },
        "prompt_sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "path": {
          "$ref": "#/definitions/projectRelativePath"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "path": {
          "$ref": "#/definitions/candidateOutputPath"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "validationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outcome"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "outcome": {
          "enum": [
            "PASS",
            "DEGRADED",
            "BLOCK",
            "ERROR"
          ]
        },
        "safe_summary": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "checks"
      ],
      "properties": {
        "state": {
          "enum": [
            "PENDING",
            "PASS",
            "BLOCK",
            "ERROR"
          ]
        },
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/validationCheck"
          }
        }
      }
    }
  }
}
