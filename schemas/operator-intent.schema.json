{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness-reserve.local/schemas/operator-intent.schema.json",
  "title": "Harness Reserve local-model operator intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "project_id",
    "action",
    "parameters",
    "reason",
    "confidence"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": [
          "boolean",
          "string",
          "integer"
        ]
      }
    },
    "reason": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 1000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
